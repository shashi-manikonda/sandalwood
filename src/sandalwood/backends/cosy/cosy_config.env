# COSY Infinity Memory Configuration
# These values replace the hardcoded defaults in the F77 sources.

# LMEM: Length of main storage stack (Default: 140000000)
# Decrease this if you are running out of RAM.
export COSY_LMEM=40000000

# LVAR: Maximum number of variables (Default: 10000000)
export COSY_LVAR=2000000

# LDIM: Maximum dimension of arrays (Default: 1000)
export COSY_LDIM=1000

# LEA: Max monomials (Default: 100000). Increase for high orders.
export COSY_LEA=100000

# LIA: Dimension of integer arrays (Default: 1400000)
export COSY_LIA=1400000

# LNO: Maximum Order (Default: 99)
export COSY_LNO=99

# LNV: Maximum Number of Variables (Default: 40)
export COSY_LNV=40
